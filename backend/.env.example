# Salin ke Vercel > Project > Settings > Environment Variables (JANGAN commit file .env asli)

# Connection string dari MongoDB Atlas (Connect > Drivers). Ganti <password> dan nama user.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=neonswarm

# Origin game (GitHub Pages), tanpa path & tanpa garis miring di akhir. Pisahkan koma jika lebih dari satu.
ALLOWED_ORIGINS=https://USERNAME.github.io

# Garam untuk hash IP (string acak panjang). IP tidak disimpan mentah.
IP_SALT=ganti-dengan-string-acak-panjang

# Hanya untuk `vercel dev` lokal: izinkan http://localhost:* (biarkan kosong di production)
ALLOW_LOCALHOST=
